{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
